{
  "name": "smallice-docs",
  "installCommand": "npm ci",
  "buildCommand": "npm run docs:build:edgeone",
  "outputDirectory": "src/.vuepress/dist",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
