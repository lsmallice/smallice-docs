{
  "name": "smallice-docs",
  "version": "0.1.0",
  "description": "A VuePress Theme Hope documentation site.",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:dev": "vuepress dev src",
    "docs:build": "vuepress build src",
    "docs:build:github": "DOCS_BASE=/smallice-docs/ DOCS_HOSTNAME=https://lsmallice.github.io vuepress build src",
    "docs:build:edgeone": "DOCS_BASE=/ DOCS_HOSTNAME=https://docs.smallice.chat vuepress build src",
    "docs:clean-dev": "vuepress dev src --clean-cache",
    "docs:clean-build": "vuepress build src --clean-cache"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.26",
    "sass-embedded": "^1.93.3",
    "vue": "^3.5.22",
    "vuepress": "^2.0.0-rc.26",
    "vuepress-theme-hope": "^2.0.0-rc.102"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
